```gitignore
# Dependencies
node_modules/

# Claude local config / sessions
.claude/

# Expo
.expo/
.expo-shared/
web-build/

# React Native / native build outputs
ios/build/
android/build/
android/app/build/

# Metro / bundler
.metro-cache/
.cache/

# Build outputs
dist/
build/
coverage/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE/editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Temporary files
.tmp/
temp/

# Testing
.jest/
```
